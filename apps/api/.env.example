# Copy to apps/api/.env and fill in. Never commit the real .env.
# Neon (free): Dashboard -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/aerosys?sslmode=require
PORT=3000
WEB_ORIGIN=http://localhost:5173
MIGRATE_ON_START=true
# Signs login tokens. Any long random string; generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
