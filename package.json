{
  "name": "aerosys-hvac",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @aerosys/web dev",
    "dev:api": "pnpm --filter @aerosys/api start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aerosys/api db:generate",
    "db:migrate": "pnpm --filter @aerosys/api db:migrate",
    "db:seed": "pnpm --filter @aerosys/api db:seed",
    "db:create-user": "pnpm --filter @aerosys/api db:create-user"
  }
}
